<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Minimalist Editorial Native Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#000000"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AETHERSENSE v3.0 // iQOO 15 HARDWARE ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnServiceToggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="SERVICE: RUNNING"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Full-Featured Hardware-Accelerated Local Observatory WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

</LinearLayout>
